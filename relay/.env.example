# Copy to relay/.env for local runs (or set as a real env var, e.g. via
# $env:RELAY_TOKEN in PowerShell before starting uvicorn). Required — the
# relay refuses every request without a matching token.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# The same value goes into the deployed backend's NBA_STATS_RELAY_TOKEN
# (see backend/.env.example).
RELAY_TOKEN=
