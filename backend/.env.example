# Copy to backend/.env and adjust for your environment. All settings have
# working local-dev defaults (see backend/config.py) — this file only
# needs to be filled in for a non-default setup (e.g. a hosted deployment).

# SNAPSHOT_PATH=data/processed/live_reference_snapshot.joblib
# MODELS_DIR=models/injury_risk

# Comma-separated list of origins allowed to call this API directly from a
# browser (e.g. FastAPI's /docs). Real frontend traffic goes through the
# Next.js server-side proxy and never needs this.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# TEAM_STATS_CACHE_TTL_SECONDS=21600

# stats.nba.com blocks datacenter IPs (confirmed for Heroku, applies to
# Render/Railway/Fly too — see backend/nba_relay.py). If you're hosting
# on one of those, run relay/main.py somewhere non-cloud (e.g. your own
# PC) and point these at it. Leave both unset for local dev.
# NBA_STATS_RELAY_URL=https://your-tunnel-url.example.com
# NBA_STATS_RELAY_TOKEN=<same value as relay/.env's RELAY_TOKEN>
